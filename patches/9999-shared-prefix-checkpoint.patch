+//! Modified/added by deepseek-spark-cache-io contributors, 2026-10-29.
+//! Shared-prefix checkpoint and optional stream timing extension; Apache-2.0.
+//! Metadata-only first streamed-event timings; no response or prompt text retained.
+const std = @import("std");
+const json = @import("json.zig");
+pub const Seen = struct {
+    reasoning: ?i96 = null,
+    content: ?i96 = null,
+    tool: ?i96 = null,
+    pub fn note(s: *Seen, payload: json.Value, now: i96) void {
+        const choices = payload.get("choices") orelse return;
+        if (choices != .array) return;
+        for (choices.array) |choice| {
+            const delta = choice.get("delta") orelse choice;
+            if (s.reasoning == null and (visible(delta.strField("reasoning_content")) or visible(delta.strField("reasoning")))) s.reasoning = now;
+            if (s.content == null and (visible(delta.strField("content")) or visible(choice.strField("text")))) s.content = now;
+            if (s.tool == null) if (delta.get("tool_calls")) |calls| if (calls == .array) {
+                for (calls.array) |call| if (call.get("function")) |f| {
+                    if (visible(f.strField("name")) or visible(f.strField("arguments"))) { s.tool = now; break; }
+                };
+            };
+        }
+    }
+};
+fn visible(text: ?[]const u8) bool {
+    return if (text) |s| std.mem.trim(u8, s, " \r\n\t").len > 0 else false;
+}
+pub fn milliseconds(at: ?i96, start: i96) i64 {
+    return if (at) |t| @intCast(@divTrunc(@max(0, t - start), std.time.ns_per_ms)) else -1;
+}
+pub fn probeTag(messages: json.Value) u8 {
+    if (messages != .array) return '-';
+    for (messages.array) |message| {
+        if (!std.mem.eql(u8, message.strField("role") orelse "", "user")) continue;
+        const content = message.get("content") orelse continue;
+        if (content == .string) {
+            if (tagIn(content.string)) |tag| return tag;
+        } else if (content == .array) {
+            for (content.array) |part| if (part.strField("text")) |text| {
+                if (tagIn(text)) |tag| return tag;
+            };
+        }
+    }
+    return '-';
+}
+fn tagIn(text: []const u8) ?u8 {
+    const marker = "ASIDE_STARTUP_PROBE_20261029_";
+    const at = std.mem.indexOf(u8, text, marker) orelse return null;
+    const next = at + marker.len;
+    if (next >= text.len) return null;
+    return if (text[next] == 'A' or text[next] == 'B') text[next] else null;
+}
+test "diagnostic probe tags retain only a known test letter, never system or message text" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator); defer arena.deinit();
+    const a = arena.allocator();
+    try std.testing.expectEqual(@as(u8, 'B'), probeTag((try json.parse(a, "[{\"role\":\"user\",\"content\":\"ASIDE_STARTUP_PROBE_20261029_B private\"}]")).ok));
+    try std.testing.expectEqual(@as(u8, '-'), probeTag((try json.parse(a, "[{\"role\":\"system\",\"content\":\"ASIDE_STARTUP_PROBE_20261029_A\"}]")).ok));
+    try std.testing.expectEqual(@as(u8, '-'), probeTag((try json.parse(a, "[{\"role\":\"user\",\"content\":\"ordinary private request\"}]")).ok));
+}
+test "stream timing ignores empty framing and preserves the first visible event" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator); defer arena.deinit();
+    const a = arena.allocator(); var s: Seen = .{};
+    s.note((try json.parse(a, "{\"choices\":[{\"delta\":{\"role\":\"assistant\",\"content\":\" \",\"reasoning_content\":\"\\n\"}}]}")).ok, 10);
+    try std.testing.expect(s.content == null and s.reasoning == null and s.tool == null);
+    s.note((try json.parse(a, "{\"choices\":[{\"delta\":{\"reasoning_content\":\"reason\"}}]}")).ok, 20);
+    s.note((try json.parse(a, "{\"choices\":[{\"delta\":{\"content\":\"answer\"}}]}")).ok, 30);
+    s.note((try json.parse(a, "{\"choices\":[{\"delta\":{\"content\":\"later\",\"tool_calls\":[{\"function\":{\"name\":\"repl\"}}]}}]}")).ok, 40);
+    try std.testing.expectEqual(@as(?i96, 20), s.reasoning);
+    try std.testing.expectEqual(@as(?i96, 30), s.content);
+    try std.testing.expectEqual(@as(?i96, 40), s.tool);
+    try std.testing.expectEqual(@as(i64, -1), milliseconds(null, 0));
+}
