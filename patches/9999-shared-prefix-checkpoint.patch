+//! Modified/added by deepseek-spark-cache-io contributors, 2026-10-29.
+//! Shared-prefix checkpoint and optional stream timing extension; Apache-2.0.
+//! Optional additional shared-system-prefix checkpoint. It never changes prompt tokens.
+const std = @import("std");
+
+pub fn configured(raw: ?[]const u8, system_len: usize) ?u32 {
+    const text = raw orelse return null;
+    const cut = std.fmt.parseInt(u32, text, 10) catch return null;
+    if (cut < 2048 or cut % 2048 != 0) return null;
+    if (cut > system_len -| 2048) return null;
+    return cut;
+}
+
+test "extra shared checkpoint is default-off and rejects malformed or unaligned values" {
+    for ([_]?[]const u8{ null, "", "0", "-2048", "1", "8193", " 8192", "18446744073709551615" }) |raw| {
+        try std.testing.expectEqual(@as(?u32, null), configured(raw, 100000));
+    }
+}
+
+test "extra checkpoint stays inside a long system prefix with a full chunk remaining" {
+    try std.testing.expectEqual(@as(?u32, 22528), configured("22528", 31881));
+    try std.testing.expectEqual(@as(?u32, 22528), configured("22528", 24576));
+    try std.testing.expectEqual(@as(?u32, null), configured("22528", 24575));
+    try std.testing.expectEqual(@as(?u32, null), configured("22528", 100));
+    try std.testing.expectEqual(@as(?u32, null), configured("22528", 0));
+}
