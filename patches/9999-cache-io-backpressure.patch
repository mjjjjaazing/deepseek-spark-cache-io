+fn enableIo(r: *Rig) void {
+    if (@hasField(LaneHost, "io_backpressure")) {
+        r.host.io_backpressure = true;
+        r.host.image_io_min_tokens = 8;
+    }
+}
+
+test "io-only: a short fresh image does not wait behind unrelated disk I/O" {
+    const r = try Rig.createUnstarted(.{ .load_wait_ms = 2000 }, enableIo);
+    defer r.destroy();
+    r.tier.gate.store(false, .release);
+    _ = try r.point(&t2, 8);
+    var disk: Box = .{};
+    defer disk.deinit();
+    var img: Box = .{};
+    defer img.deinit();
+    defer r.stop();
+    const ids = [_]u32{ 4, 2, 1, 3 };
+    const short: Request = .{ .prompt = &ids, .images = &test_images, .max_tokens = 1 };
+    try r.host.engine().submit(1, &disk_request, disk.sink());
+    try r.host.engine().submit(2, &short, img.sink());
+    try r.host.start();
+    try std.testing.expectEqual(Reason.length, try waitBounded(&img));
+    try std.testing.expect(disk.finished() == null);
+    r.tier.gate.store(true, .release);
+    try std.testing.expectEqual(Reason.length, try waitBounded(&disk));
+    try img.exact(&ids);
+    try disk.exact(&t2);
+    r.stop();
+    try std.testing.expectEqual(@as(u64, 0), r.host.host_counts.restore_wait_timeouts);
+}
+
+fn waitBounded(b: *Box) !Reason {
+    for (0..5000) |_| {
+        if (b.finished()) |why| return why;
+        try std.Io.sleep(io, .fromMilliseconds(1), .awake);
+    }
+    return error.Timeout;
+}
+
+const image_ids: [32]u32 = @splat(7);
+const test_images = [_]api.Image{.{ .at = 0, .tokens = 1, .bytes = "" }};
+const image_request: Request = .{ .prompt = &image_ids, .images = &test_images, .max_tokens = 1 };
+const disk_request: Request = .{ .prompt = &t2, .max_tokens = 1, .history_len = 14 };
+
+fn imageStarvation(enabled: bool, expected_cached: u32) !void {
+    const r = try Rig.createUnstarted(.{ .load_ms = 5, .load_wait_ms = 200 }, if (enabled) enableIo else null);
+    defer r.destroy();
+    const Hook = struct {
+        fn call(_: *anyopaque, s: *lanes.Stream, _: usize) void {
+            if (s.prompt_len == image_ids.len) std.Io.sleep(io, .fromMilliseconds(300), .awake) catch {};
+        }
+    };
+    r.target.prefill_chunks = 1;
+    r.target.prefill_hook = Hook.call;
+    r.target.prefill_hook_ctx = r;
+    _ = try r.point(&t2, 8);
+    var disk: Box = .{};
+    defer disk.deinit();
+    var img: Box = .{};
+    defer img.deinit();
+    defer r.stop();
+    try r.host.engine().submit(1, &disk_request, disk.sink());
+    try r.host.engine().submit(2, &image_request, img.sink());
+    try r.host.start();
+    try std.testing.expectEqual(Reason.length, try waitBounded(&disk));
+    try std.testing.expectEqual(Reason.length, try waitBounded(&img));
+    r.stop();
+    std.debug.print("cached={d}, committed={d}, timeouts={d}\n", .{ disk.cached.?, r.store.stats.disk_hits_committed, r.host.host_counts.restore_wait_timeouts });
+    try std.testing.expectEqual(@as(?u32, expected_cached), disk.cached);
+    try std.testing.expectEqual(@as(u64, if (expected_cached == 0) 1 else 0), r.host.host_counts.restore_wait_timeouts);
+    try disk.exact(&t2);
+    try img.exact(&image_ids);
+    try std.testing.expectEqual(@as(u64, 0), r.tier.misuse);
+}
+
+test "io-only: pending restore survives an image prefill longer than its wait bound" {
+    try imageStarvation(true, 8);
+}
+
+test "io-only: disabled switch preserves the original image timeout behavior" {
+    try imageStarvation(false, 0);
+}
+
+test "io-only: existing full-tier retry and bounded fallback work without a new capacity gate" {
+    for ([_]bool{ false, true }) |never_opens| {
+        const r = try Rig.createUnstarted(.{ .load_ms = 5, .defer_ms = if (never_opens) 30 else 1000 }, enableIo);
+        defer r.destroy();
+        r.host.tier.defer_min = 1;
+        r.tier.full = if (never_opens) 1_000_000 else 3;
+        _ = try r.point(&t2, 8);
+        var b: Box = .{};
+        defer b.deinit();
+        defer r.stop();
+        try r.host.engine().submit(1, &disk_request, b.sink());
+        try r.host.start();
+        try std.testing.expectEqual(Reason.length, try waitBounded(&b));
+        r.stop();
+        try std.testing.expectEqual(@as(?u32, if (never_opens) 0 else 8), b.cached);
+        try std.testing.expectEqual(@as(u64, if (never_opens) 1 else 0), r.host.host_counts.restores_deferred_expired);
+        try b.exact(&t2);
+        try std.testing.expectEqual(@as(u64, 0), r.tier.misuse);
+    }
+}
+
+test "io-only: image held behind I/O can be cancelled and shutdown drains both waiters" {
+    for ([_]bool{ false, true }) |shutdown| {
+        const r = try Rig.createUnstarted(.{ .load_ms = 5, .load_wait_ms = 2000 }, enableIo);
+        defer r.destroy();
+        r.tier.gate.store(false, .release);
+        _ = try r.point(&t2, 8);
+        var disk: Box = .{};
+        defer disk.deinit();
+        var img: Box = .{};
+        defer img.deinit();
+        defer r.stop();
+        try r.host.engine().submit(1, &disk_request, disk.sink());
+        try r.host.engine().submit(2, &image_request, img.sink());
+        try r.host.start();
+        try r.until(struct {
+            fn ok(s: api.CacheStats) bool {
+                return s.restore_waits == 1;
+            }
+        }.ok);
+        if (shutdown) r.stop() else r.host.engine().cancel(2);
+        try std.testing.expectEqual(Reason.cancelled, try waitBounded(&img));
+        try std.testing.expectEqual(@as(?u32, null), img.cached);
+        r.tier.gate.store(true, .release);
+        try std.testing.expectEqual(if (shutdown) Reason.cancelled else Reason.length, try waitBounded(&disk));
+        r.stop();
+        try std.testing.expectEqual(@as(u64, 0), r.tier.misuse);
+        try std.testing.expectEqual(@as(u64, if (shutdown) 1 else 0), r.tier.cancels);
+    }
+}
+
+test "io-only: fresh text is admitted while a disk restore is pending" {
+    const r = try Rig.createUnstarted(.{ .load_wait_ms = 2000 }, enableIo);
+    defer r.destroy();
+    r.tier.gate.store(false, .release);
+    _ = try r.point(&t2, 8);
+    var disk: Box = .{};
+    defer disk.deinit();
+    var fresh: Box = .{};
+    defer fresh.deinit();
+    defer r.stop();
+    const text: Request = .{ .prompt = &image_ids, .max_tokens = 1 };
+    try r.host.engine().submit(1, &disk_request, disk.sink());
+    try r.host.engine().submit(2, &text, fresh.sink());
+    try r.host.start();
+    try std.testing.expectEqual(Reason.length, try waitBounded(&fresh));
+    try std.testing.expect(disk.finished() == null);
+    r.tier.gate.store(true, .release);
+    try std.testing.expectEqual(Reason.length, try waitBounded(&disk));
+    try fresh.exact(&image_ids);
+    try disk.exact(&t2);
+}
+
+test "io-only: permanently busy writes cannot block an image forever" {
+    const r = try Rig.createUnstarted(.{ .load_wait_ms = 10 }, enableIo);
+    defer r.destroy();
+    const Busy = struct {
+        fn busy(_: *anyopaque) bool {
+            return true;
+        }
+    };
+    var vtable = r.store.tier.?.vtable.*;
+    vtable.busy = Busy.busy;
+    r.store.tier.?.vtable = &vtable;
+    var img: Box = .{};
+    defer img.deinit();
+    defer r.stop();
+    try r.host.engine().submit(1, &image_request, img.sink());
+    try r.host.start();
+    try std.testing.expectEqual(Reason.length, try waitBounded(&img));
+    try img.exact(&image_ids);
+}
+
+test "io-only: no pending work leaves the image path and decode budget alone" {
+    const r = try Rig.createUnstarted(.{}, enableIo);
+    defer r.destroy();
+    r.host.interleave_ns = 250 * std.time.ns_per_ms;
+    var img: Box = .{};
+    defer img.deinit();
+    defer r.stop();
+    try r.host.engine().submit(1, &image_request, img.sink());
+    try r.host.start();
+    try std.testing.expectEqual(Reason.length, try waitBounded(&img));
+    r.stop();
+    try std.testing.expectEqual(@as(i96, 250 * std.time.ns_per_ms), r.host.interleave_ns);
+    try img.exact(&image_ids);
+}
